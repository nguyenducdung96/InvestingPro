{
  "name": "investing-pro-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "env": {
    "preview": { "name": "investing-pro-web-preview" },
    // Staging uses the tested Next.js 16.3.8 compatibility branch until merged.
    "staging": {
      "name": "investing-pro-web-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "PORT_CALL_IMPORT_MODE": "edge" },
    },
  },
}
